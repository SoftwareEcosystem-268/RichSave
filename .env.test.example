# Test Credentials Configuration
# Copy this file to .env.test and fill in your actual credentials

# Your valid login credentials for testing
TEST_EMAIL=your-email@example.com
TEST_PASSWORD=YourValidPassword123

# Optional: Test user for registration tests
TEST_REGISTER_NAME=Test User
TEST_REGISTER_EMAIL=testuser@example.com
TEST_REGISTER_PASSWORD=TestPassword123

# API URL (defaults to localhost)
NEXT_PUBLIC_API_URL=http://localhost:3000

# JWT Secret (use same as production for accurate testing)
JWT_SECRET=your-jwt-secret-here

# Optional: MongoDB connection for integration tests
MONGODB_URI=mongodb://localhost:27017/richsave-test
